# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Kaisa API
DEBUG=false

# 배포 환경 (local | staging | production) — Sentry environment 태그 등으로 사용
ENVIRONMENT=local

# AWS Secrets Manager 시크릿 이름. 설정 시 부팅 시 해당 시크릿에서 환경변수 로드.
# 로컬은 비워 두고 .env 파일 직접 사용.
# AWS_SECRETS_NAME=
AWS_REGION=ap-northeast-2

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# 로컬: brew/Postgres.app 으로 localhost PG 실행 후 kaisa role + DB 생성 (README 참고)
# 아래 값은 로컬 dev 기본값 — 그대로 써도 동작
DATABASE_URL=postgresql+asyncpg://kaisa:kaisa@localhost:5432/kaisa

# PostgreSQL 비밀번호 (docker-compose DB 컨테이너와 공유)
DB_PASSWORD=kaisa

# ── CORS / Frontend ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# 추가 CORS 오리진 (쉼표 구분, 선택). 비우면 FRONTEND_URL 단일 허용
# vite 기본 포트(5173)와 두 번째 인스턴스(5174) — 프록시 경유면 불필요하지만 직접 호출 대비
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── 세션 ──────────────────────────────────────────────────────────────────────
# DB 세션 테이블 + httponly 쿠키. 토큰이 opaque 랜덤이라 서명키는 없음
SESSION_COOKIE_NAME=kaisa_session
SESSION_TTL_HOURS=24

# ── 개인정보 암호화 ───────────────────────────────────────────────────────────
# Fernet 키 (필수) — 생성 (url-safe base64 필수라 openssl 대신 이 명령):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 로컬 DB에 실 이관 개인정보(전화번호)가 있으므로 키는 커밋하지 않는다
CRYPTO_KEY=
# 진위확인 IP 해시용 솔트 (선택) — 비우면 CRYPTO_KEY 사용
IP_HASH_SALT=

# ── PortOne (본인인증·결제) ───────────────────────────────────────────────────
PORTONE_API_BASE=https://api.portone.io
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_PAYMENT_CHANNEL_KEY=
PORTONE_IDENTITY_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=

# ── Rate limit (선택 — 기본값은 config.py 참고) ───────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_PUBLIC_VERIFY_MAX=10
RATE_LIMIT_PUBLIC_VERIFY_WINDOW=60

# ── 확인서 ────────────────────────────────────────────────────────────────────
# 유효기간(일). 0 = 무기한
CERTIFICATE_VALID_DAYS=0

# ── 시드 (make seed) ─────────────────────────────────────────────────────────
# 마스터 admin 계정. 운영에서는 Secrets Manager가 강한 값으로 override (이 파일 무시됨)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-passw0rd

# ── Sentry ────────────────────────────────────────────────────────────────────
# DSN. 비우면 Sentry 비활성화 (로컬 기본).
SENTRY_DSN=
# 릴리즈 식별자 — 배포 태그. 비우면 릴리즈 미지정
RELEASE=
