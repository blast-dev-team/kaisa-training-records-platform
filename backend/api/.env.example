# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Kaisa API
DEBUG=false

# 배포 환경 (local | staging | production) — Sentry environment 태그 등으로 사용
ENVIRONMENT=local

# AWS Secrets Manager 시크릿 이름. 설정 시 부팅 시 해당 시크릿에서 환경변수 로드.
# 로컬은 비워 두고 .env 파일 직접 사용.
# AWS_SECRETS_NAME=
AWS_REGION=ap-northeast-2

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# 로컬: brew/Postgres.app 으로 localhost PG 실행 후 kaisa role + DB 생성 (README 참고)
DATABASE_URL=postgresql+asyncpg://kaisa:kaisa@localhost:5432/kaisa

# PostgreSQL 비밀번호 (docker-compose DB 컨테이너와 공유)
DB_PASSWORD=your-strong-password-here

# ── CORS / Frontend ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Sentry ────────────────────────────────────────────────────────────────────
# DSN. 비우면 Sentry 비활성화 (로컬 기본).
SENTRY_DSN=
# 릴리즈 식별자 — 배포 태그. 비우면 릴리즈 미지정
RELEASE=
