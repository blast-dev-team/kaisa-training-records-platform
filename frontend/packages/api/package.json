{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./models": "./src/generated/models/index.ts",
    "./apis": "./src/generated/apis/index.ts"
  },
  "scripts": {
    "generate": "openapi-generator-cli generate",
    "clean": "rm -rf ./src/generated",
    "regenerate": "pnpm clean && pnpm generate",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.14.0",
    "@repo/typescript-config": "workspace:*",
    "typescript": "5.9.2"
  }
}
