# Backend API base URL (FastAPI). 로컬: http://localhost:8000
VITE_API_URL=http://localhost:8000

# 배포 환경 ('local' | 'staging' | 'production')
VITE_ENV=local

# Cap 보안문자 검증 서버 엔드포인트 — 대시보드에서 발급받은 사이트 키 포함 전체 경로
# 예: https://cap.example.com/abc123/
VITE_CAP_API_ENDPOINT=

# 포트원 결제 — 관리자콘솔(https://admin.portone.io) 결제연동 > 연동 정보
# 테스트 채널(kcp_v2) 키. Store ID는 콘솔 내 정보에서 확인
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
